# Local development only. Generate with: openssl rand -hex 32
TOKEN_HASH_SECRET=replace-with-at-least-32-random-bytes-before-starting
# Generate from 32 random bytes, base64 encoded. Encrypts OIDC client secrets at rest.
OIDC_CONFIG_KEY=replace-with-base64-encoded-32-random-bytes
# Used by the application container.
DATABASE_URL=postgres://provision:local-only-change-me@localhost:5432/provision?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
LISTEN_ADDR=:8080
DEV_MODE=true
COOKIE_SECURE=false

# authentik 2026.8.5 local development values; replace all secrets.
AUTHENTIK_TAG=2026.8.5
PG_PASS=replace-with-a-random-authentik-database-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-authentik-secret
